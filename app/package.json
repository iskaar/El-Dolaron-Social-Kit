{
  "name": "el-dolaron-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:esquema": "node armar-esquema.mjs",
    "db:local": "npm run db:esquema && wrangler d1 execute el-dolaron --local --file=.wrangler/esquema-completo.sql"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
