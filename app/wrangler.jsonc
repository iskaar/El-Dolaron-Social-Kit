{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-dolaron",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Sin esto, los HTML se sirven ANTES del Worker y el filtro por hostname
    // nunca los ve: /admin y /caja quedaban abiertos en la puerta del vendedor.
    "run_worker_first": true
  },
  "vars": {
    // Numero de WhatsApp para responder desde /mensajes (Issue #290). Publico, no secreto.
    "WHATSAPP_PHONE_NUMBER_ID": "1433484303171531",
    // Ese hostname solo sirve la camara y la subida de fotos: el vendedor no
    // llega a precios ni a la caja aunque escriba la ruta.
    "HOST_VENDEDOR": "captura.viste.com.mx",
    // Claude Haiku 4.5 desde 2026-09-26 (Issue #91): se acabo el credito de
    // Gemini. Haiku estima el precio de memoria; la busqueda en tiendas
    // mexicanas (BUSQUEDA_WEB, ver analisis.ts) hoy solo existe con Gemini, asi
    // que con "claude" no hace nada. Para volver a Gemini: "gemini".
    "MODELO_ANALISIS": "claude",
    "BUSQUEDA_WEB": "si",
    // Portal de clientes de Dolarones (#129). Sin Access: el cliente entra con
    // su telefono (Firebase). Sin bases aprobadas el portal responde cerrado.
    // El apiKey web no es secreto: solo identifica el proyecto Firebase.
    "HOST_PORTAL": "dolarones.eldolaron.com",
    "FIREBASE_PROJECT_ID": "el-dolaron",
    "FIREBASE_WEB_API_KEY": "AIzaSyBNauTOpaIaRagXrz0mn3yV1n4MrA4cab4",
    // Encendido de Dolarones (Isaac, 01/10). Altas, vales y premios esperan a
    // PROMOCION_INICIO: lunes 5/10/2026, 11:00 hora de la tienda (UTC-6).
    // Apagado de emergencia: quitar PORTAL_REGISTRO_ABIERTO o VALES_ABIERTOS y desplegar.
    "BASES_APROBADAS_VERSION": "2026-10-v5",
    "PROMOCION_INICIO": "2026-10-05T17:00:00Z",
    "VALES_ABIERTOS": "si",
    // Promo de inauguracion (Issue #487): se enciende con PROMO_DESDE, PROMO_HASTA y PROMO_CUPO (ver descuentos.ts).
    // La del 24-25/10 ya vencio; se quitaron las variables el 27/10 a pedido de Isaac.
    // Conteo de alto valor (Issue #219): piezas en existencia con precio >= este monto, en centavos.
    "CONTEO_UMBRAL": "30000",
    // Mercado Libre (Issue #170): debe ser identica a la URI de redireccion de la
    // app en el DevCenter. ML_CLIENT_ID, ML_CLIENT_SECRET, ML_LLAVE_TOKENS y
    // ML_RUTA_NOTIFICACIONES son secretos (wrangler secret put), no van aqui.
    "ML_REDIRECT_URI": "https://escaner.viste.com.mx/ml/callback",
    "PORTAL_REGISTRO_ABIERTO": "si",
    // Referidos abiertos a todo socio (Issue #597). Apagado de emergencia: quitarla y desplegar.
    "REFERIDOS_ABIERTO": "si",
    // Con que se verifica el JWT de Cloudflare Access (src/cuentas.ts). No son
    // secretos: salen en la redireccion al login de cada hostname. El aud es
    // por aplicacion de Access; una aplicacion nueva necesita su renglon aqui
    // o nadie entra por ese hostname.
    "ACCESS_EQUIPO": "yellow-term-7d99.cloudflareaccess.com",
    "ACCESS_AUD": {
      "escaner.viste.com.mx": "8ecef061fac92da30e9b780d70c749c2a4bc91c7a04d3070c35f7d9d23eb451d",
      "captura.viste.com.mx": "d3ee26fb77afa5141ca79be9eeba23d7cf93e31165b1fc1683396c1296629764"
    }
  },
  // Concilia existencias con Mercado Libre y recoge ordenes perdidas; sin cuenta conectada no hace nada.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // El Worker solo debe responder detras de Access: workers.dev y las URLs de
  // vista previa se saltarian el login.
  "workers_dev": false,
  "preview_urls": false,
  // Hostnames propios: Cloudflare Access solo protege dominios de una zona, no workers.dev.
  "routes": [
    {
      "pattern": "escaner.viste.com.mx",
      "custom_domain": true
    },
    {
      // Puerta del vendedor, con su propia aplicacion de Access (politica
      // "Vendedor"). Nunca publicar este hostname sin esa aplicacion: solo
      // sirve la camara, pero acepta fotos y esas fotos cuestan analisis.
      "pattern": "captura.viste.com.mx",
      "custom_domain": true
    },
    {
      // Portal de clientes: NUNCA detras de Access, lo abre el publico.
      "pattern": "dolarones.eldolaron.com",
      "custom_domain": true
    }
  ],
  // Avisos al dueno (Issue #75, avisos.ts): remitente avisos@eldolaron.com, destinatarios desde D1.
  "send_email": [{ "name": "CORREO", "allowed_sender_addresses": ["avisos@eldolaron.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-dolaron",
      "database_id": "26435b29-79ae-44bf-942d-3bac138c5805"
    }
  ],
  "kv_namespaces": [
    { "binding": "WHATSAPP_EVENTOS", "id": "d6cbf480b05d47c7a17d53d8e4b461a8" }
  ],
  "images": { "binding": "IMAGES" },
  // Tope por IP a la API pública del portal (worker.ts, rutaPortalPublico): 100 peticiones por minuto.
  // Las fotos del catálogo no cuentan. Para subirlo basta cambiar limit y desplegar.
  "ratelimits": [{ "name": "LIMITE_PORTAL", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "el-dolaron-fotos"
    }
  ],
  // Búsquedas de códigos fuera de la hoja (#406): sin el tope de 30 s de waitUntil.
  "queues": {
    "producers": [{ "binding": "BUSQUEDAS", "queue": "el-dolaron-busquedas" }],
    "consumers": [{ "queue": "el-dolaron-busquedas", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 1 }]
  }
}
