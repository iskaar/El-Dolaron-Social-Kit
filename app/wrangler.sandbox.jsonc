{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sandbox (Issue #83): el mismo codigo que produccion, con base y fotos
  // aparte, para probar caja, socios y Dolarones sin tocar la tienda. Como
  // wrangler.prestado.jsonc, la separacion es fisica: otra D1, otro R2.
  //
  //   npx wrangler deploy --config wrangler.sandbox.jsonc
  //   python ../tools/refrescar_sandbox.py      (copia produccion -> sandbox)
  //
  // Sin llaves de Claude ni AI Studio a proposito. Solo VERTEX_API_KEY (Issue
  // #363): aqui se prueba Gemini en Vertex con busqueda antes de produccion.
  "name": "el-dolaron-sandbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Igual que produccion: los HTML pasan por el Worker (permisos y franja).
    "run_worker_first": true
  },
  "vars": {
    // Pinta la franja SANDBOX en todas las pantallas (worker.ts).
    "AMBIENTE": "sandbox",
    "CONTEO_UMBRAL": "30000",
    "MODELO_ANALISIS": "gemini",
    "BUSQUEDA_WEB": "si",
    // Ensayo de Dolarones: portal propio, mismo proyecto Firebase (usar los
    // numeros de prueba de Firebase, no gastan SMS) y promocion ya iniciada.
    "HOST_PORTAL": "sandbox.eldolaron.com",
    "FIREBASE_PROJECT_ID": "el-dolaron",
    "FIREBASE_WEB_API_KEY": "AIzaSyBNauTOpaIaRagXrz0mn3yV1n4MrA4cab4",
    "BASES_APROBADAS_VERSION": "2026-10-v6",
    "PROMOCION_INICIO": "2026-10-01T00:00:00Z",
    "VALES_ABIERTOS": "si",
    // Promo de inauguracion: en el sandbox ya esta corriendo y con cupo de 3, para probar
    // en la caja que se agota antes de la inauguracion (prod: sabado 10/10 10:00, cupo 100).
    "PROMO_DESDE": "2026-10-08T06:00:00Z",
    "PROMO_HASTA": "2026-10-13T06:00:00Z",
    "PROMO_CUPO": "3",
    "PORTAL_REGISTRO_ABIERTO": "si",
    // Referidos abiertos a todo socio (Issue #597). Apagado de emergencia: quitarla y desplegar.
    "REFERIDOS_ABIERTO": "si",
    "ACCESS_EQUIPO": "yellow-term-7d99.cloudflareaccess.com",
    // El aud es por aplicacion de Access: sandbox.viste.com.mx se agrega como
    // dominio a la MISMA aplicacion que escaner.viste.com.mx, asi que comparte
    // su aud. Si algun dia tiene aplicacion propia, va su aud aqui.
    "ACCESS_AUD": {
      "sandbox.viste.com.mx": "8ecef061fac92da30e9b780d70c749c2a4bc91c7a04d3070c35f7d9d23eb451d"
    }
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sandbox.viste.com.mx",
      "custom_domain": true
    },
    {
      // Portal del sandbox, sin Access como el real.
      "pattern": "sandbox.eldolaron.com",
      "custom_domain": true
    }
  ],
  // Avisos al dueno (Issue #75): mismo remitente; el asunto lleva [Sandbox].
  "send_email": [{ "name": "CORREO", "allowed_sender_addresses": ["avisos@eldolaron.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-dolaron-sandbox",
      "database_id": "f25c3e83-4dfe-4c43-a9b0-3623ffa8d369"
    }
  ],
  "images": { "binding": "IMAGES" },
  // Tope por IP a la API pública del portal (worker.ts, rutaPortalPublico): 100 peticiones por minuto.
  // Las fotos del catálogo no cuentan. Para subirlo basta cambiar limit y desplegar.
  "ratelimits": [{ "name": "LIMITE_PORTAL", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }],
  // Medición de la ficha (Issue #651, docs/UX-COMPRA.md §6): Workers Analytics Engine, autorizado por Isaac en #643 (D1, 31/10/2026).
  // El dataset se crea solo con la primera escritura. Solo guarda evento, código de pieza y origen.
  "analytics_engine_datasets": [{ "binding": "EVENTOS", "dataset": "el_dolaron_eventos_sandbox" }],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "el-dolaron-sandbox-fotos"
    }
  ],
  // Búsquedas de códigos fuera de la hoja (#406): sin el tope de 30 s de waitUntil.
  "queues": {
    "producers": [{ "binding": "BUSQUEDAS", "queue": "el-dolaron-sandbox-busquedas" }],
    "consumers": [{ "queue": "el-dolaron-sandbox-busquedas", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 1 }]
  }
}
