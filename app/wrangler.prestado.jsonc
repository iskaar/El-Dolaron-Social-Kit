{
  "$schema": "node_modules/wrangler/config-schema.json",
  // DORMIDA desde 8/10/2026 (Isaac): escaner2.viste.com.mx ya no se usa. Se
  // conservan este archivo, la D1 y el R2 por si se abre una segunda sucursal.
  // NO desplegar asi (auditoria #233 punto 11): le falta lo que hoy exige el
  // Worker y la API responderia 401. Antes de reusarla, copiar de wrangler.jsonc:
  //   - assets: binding "ASSETS" + run_worker_first: true
  //   - ACCESS_EQUIPO / ACCESS_AUD de su propia aplicacion de Access
  //   - HOST_* y demas vars que apliquen; correr todas las migraciones en su D1
  //   - decidir con un Issue si una sucursal es otra base (esto) o tienda_id
  //     (docs/ARQUITECTURA-OBJETIVO.md, «Segunda tienda»)
  //
  // Segunda instancia: mismo codigo, base y fotos aparte.
  // La separacion es fisica, no un `where`: ninguna consulta puede mezclar sus
  // piezas con el inventario de El Dolaron porque viven en otra base.
  //
  //   npx wrangler deploy --config wrangler.prestado.jsonc
  //   npm run db:esquema    (schema.sql + todas las migraciones, solo para base vacia)
  //   npx wrangler d1 execute el-dolaron-prestado --remote --file=.wrangler/esquema-completo.sql
  //   npx wrangler secret put GEMINI_API_KEY --config wrangler.prestado.jsonc
  "name": "el-dolaron-prestado",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "public"
  },
  "vars": {
    // Gemini tiene capa gratuita: esta instancia corre con la llave de su dueño
    // y no gasta de la cuenta de El Dolaron.
    "MODELO_ANALISIS": "gemini"
  },
  "routes": [
    {
      "pattern": "escaner2.viste.com.mx",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-dolaron-prestado",
      "database_id": "cb9611fd-10bf-49d4-92f9-6bbe69dc0ab5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "el-dolaron-prestado-fotos"
    }
  ]
}
