{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    // Los imports llevan .ts para que `node --test` corra las pruebas sin compilar.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    // worker.ts importa la aritmetica de venta.js: una sola fuente de verdad
    // para la caja y el servidor, sin duplicar la funcion en dos archivos.
    "allowJs": true
  },
  // Las pruebas corren en Node (`npm test`), no en el runtime de Workers.
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "public/venta.js"],
  "exclude": ["src/**/*.test.ts"]
}
